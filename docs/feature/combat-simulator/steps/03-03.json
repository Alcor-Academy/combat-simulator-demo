{
  "task_id": "03-03",
  "project_id": "combat-simulator",
  "step_type": "atdd",
  "name": "Implement CombatRound Domain Service",
  "description": "Create the CombatRound domain service - executes a single round of combat.\n\nFile: src/domain/services/combat_round.py\n\nImplementation requirements:\n- Pure domain service (no infrastructure dependencies)\n- Constructor takes InitiativeResolver and AttackResolver\n- Method: execute(char1: Character, char2: Character, dice_roller: DiceRoller) -> RoundResult\n- CRITICAL DR-06: If attacker kills defender, defender does NOT counter-attack\n- Returns RoundResult with attacks tuple ordered by initiative",
  "motivation": "CombatRound orchestrates initiative and attacks for a single round - CRITICAL for DR-06 enforcement",
  "estimated_hours": 0.75,
  "execution_agent": "software-crafter",
  "dependencies": ["03-01", "03-02", "02-03"],
  "acceptance_criteria": [
    "CombatRound accepts InitiativeResolver and AttackResolver in constructor",
    "execute() returns RoundResult with correct attack order",
    "Attacker (initiative winner) attacks first",
    "Defender counter-attacks only if still alive after attacker's attack",
    "CRITICAL: If defender HP reaches 0 from attacker's attack, defender_damage = 0",
    "RoundResult.attacks[0] is always from initiative winner",
    "E2E Scenario 3 (attacker kills defender - no counter-attack) passes"
  ],
  "unit_tests_required": [
    "test_attacker_attacks_first",
    "test_defender_counter_attacks_when_alive",
    "test_no_counter_attack_when_defender_dies",
    "test_defender_damage_is_zero_when_defender_dies",
    "test_defender_roll_is_zero_when_defender_dies",
    "test_combat_ended_when_character_dies",
    "test_winner_set_when_combat_ends",
    "test_combat_continues_when_both_alive"
  ],
  "files_to_create": [
    "src/domain/services/combat_round.py",
    "tests/unit/domain/services/test_combat_round.py"
  ],
  "files_to_modify": [],

    "RoundResult created with valid fields",
    "round_number is positive integer",
    "attacks is immutable tuple of AttackResult",
    "First attack in tuple is from initiative winner (DR-06)",
    "round_ended_in_death property works correctly",
    "RoundResult is immutable (frozen dataclass)"
  ],
  "unit_tests_required": [
    "test_creates_round_result_with_all_fields",
    "test_round_number_must_be_positive",
    "test_attacks_is_immutable_tuple",

{
  "task_id": "01-01",
  "project_id": "combat-simulator",
  "step_type": "atdd",
  "name": "Implement Character Value Object",
  "description": "Create the Character frozen dataclass - the core domain entity representing a combatant.\n\nFile: src/domain/model/character.py\n\nImplementation requirements:\n- @dataclass(frozen=True) for immutability (DR-01)\n- Fields: name (str), hp (int >= 0), attack_power (int > 0)\n- Property: agility = hp + attack_power (derived, DR-08)\n- Property: is_alive = hp > 0\n- Method: receive_damage(amount) -> Character (returns NEW instance)\n- Validation: __post_init__ rejects empty name, negative hp, non-positive attack",
  "motivation": "Character is the foundation - all domain services operate on Characters",
  "estimated_hours": 0.5,
  "execution_agent": "software-crafter",
  "dependencies": [],
  "acceptance_criteria": [
    "Character created with valid name, hp, attack_power",
    "agility property returns hp + attack_power (computed, not stored)",
    "is_alive returns true when hp > 0, false when hp = 0",
    "receive_damage returns NEW Character instance with reduced hp",
    "Original Character unchanged after receive_damage (immutability)",
    "HP floors at 0 (receive_damage(1000) on hp=5 -> hp=0, not negative)",
    "ValueError raised for empty name",
    "ValueError raised for negative hp",
    "ValueError raised for attack_power <= 0",
    "E2E Scenario 5 (immutability) passes",
    "E2E Scenario 6 (derived agility) passes",
    "E2E Scenario 7 (empty name error) passes"
  ],
  "unit_tests_required": [
    "test_creates_character_with_valid_attributes",
    "test_computes_agility_as_hp_plus_attack_power",
    "test_agility_changes_when_hp_changes",
    "test_is_alive_returns_true_when_hp_positive",
    "test_is_alive_returns_false_when_hp_zero",
    "test_receive_damage_returns_new_instance",
    "test_receive_damage_reduces_hp_correctly",
    "test_receive_damage_floors_hp_at_zero",
    "test_original_unchanged_after_receive_damage",
    "test_rejects_empty_name",
    "test_rejects_negative_hp",
    "test_rejects_non_positive_attack_power"
  ],
  "files_to_create": [
    "src/domain/model/character.py",
    "tests/unit/domain/model/test_character.py"
  ],

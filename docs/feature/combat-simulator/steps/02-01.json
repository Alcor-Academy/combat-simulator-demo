  "step_type": "atdd",
  "name": "Implement AttackResult Value Object",
  "description": "Create the AttackResult frozen dataclass - representing the outcome of a single attack.\n\nFile: src/domain/model/attack_result.py\n\nImplementation requirements:\n- @dataclass(frozen=True) for immutability (DR-01)\n- Fields: attacker_name (str), defender_name (str), damage_dealt (int >= 0), defender_hp_after (int >= 0)\n- Property: was_lethal = defender_hp_after == 0\n- Validation: __post_init__ rejects negative damage or hp values",
  "motivation": "AttackResult captures attack outcomes for combat logging and round tracking",
  "estimated_hours": 0.5,
  "execution_agent": "software-crafter",
  "dependencies": ["01-01", "01-03"],
  "acceptance_criteria": [
    "AttackResult created with valid fields",
    "was_lethal returns true when defender_hp_after is 0",
    "was_lethal returns false when defender_hp_after > 0",
    "ValueError raised for negative damage_dealt",
    "ValueError raised for negative defender_hp_after",
    "AttackResult is immutable (frozen dataclass)"
  ],
  "unit_tests_required": [
    "test_creates_attack_result_with_valid_attributes",
    "test_was_lethal_returns_true_when_defender_hp_zero",
    "test_was_lethal_returns_false_when_defender_hp_positive",
    "test_rejects_negative_damage_dealt",
    "test_rejects_negative_defender_hp_after",
    "test_attack_result_is_immutable"
  ],

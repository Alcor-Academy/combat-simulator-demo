  "name": "Implement InitiativeResolver Domain Service",
  "description": "Create the InitiativeResolver domain service - determines combat order.\n\nFile: src/domain/services/initiative_resolver.py\n\nImplementation requirements:\n- Pure domain service (no infrastructure dependencies)\n- Constructor takes DiceRoller port for randomness injection\n- Method: resolve(char1: Character, char2: Character) -> InitiativeResult\n- Initiative = agility + dice_roll (each character rolls once)\n- Higher initiative goes first\n- Tie-breaker: higher base agility wins, or first character if still tied",
  "motivation": "InitiativeResolver implements DR-06 Attacker Advantage by determining who attacks first",
  "estimated_hours": 0.5,
  "execution_agent": "software-crafter",
  "dependencies": ["01-02", "02-02"],
  "acceptance_criteria": [
    "InitiativeResolver accepts DiceRoller in constructor",
    "resolve() returns InitiativeResult with first/second characters",
    "Higher initiative (agility + roll) determines first attacker",
    "Tie-breaker uses higher base agility",
    "Second tie-breaker: first parameter character wins",
    "E2E Scenario 3 (initiative) passes"
  ],
  "unit_tests_required": [
    "test_higher_initiative_attacks_first",
    "test_initiative_equals_agility_plus_roll",
    "test_tie_breaker_uses_higher_base_agility",
    "test_tie_breaker_first_character_wins_if_still_tied",
    "test_uses_injected_dice_roller"
  ],
  "files_to_create": [
